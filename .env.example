# Vórtex Call: copie este arquivo para .env.local e preencha. Nunca coloque o .env.local no git.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# ---------- Obrigatórias ----------

# Supabase → Project Settings → API (ou "Connect"): endereço do projeto.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Supabase → Project Settings → API Keys: chave pública "anon" (pode ir pro navegador).
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-chave-anon-aqui
# Supabase → Project Settings → API Keys: chave "service_role" (SECRETA, só no servidor).
SUPABASE_SERVICE_ROLE_KEY=cole-a-chave-service-role-aqui
# Endereço público do sistema, sem barra no fim (o domínio da Vercel ou o seu domínio próprio).
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br
# Senha que protege as rotinas automáticas (/api/cron/*). Gere com: openssl rand -hex 32
CRON_SECRET=gere-um-texto-aleatorio-longo
# Texto aleatório usado pra embaralhar o IP no limite contra robô. Gere com: openssl rand -hex 32
CRYPTO_KEY=gere-outro-texto-aleatorio-longo
# Cloudflare → painel → no canto direito da página inicial da conta: "Account ID".
CLOUDFLARE_ACCOUNT_ID=id-da-sua-conta-cloudflare
# Cloudflare → My Profile → API Tokens → Create Token, com permissão de Realtime (RealtimeKit) da conta.
CLOUDFLARE_API_TOKEN=token-da-api-cloudflare
# Cloudflare → Realtime → RealtimeKit → o app que você criou: "App ID".
REALTIMEKIT_APP_ID=id-do-app-realtimekit

# ---------- Opcionais ----------

# Nome da sua empresa nos textos fixos (título na agenda do Google, aba da sala, pedido pra IA). Ex.: Sua Empresa
NEXT_PUBLIC_EMPRESA_NOME=
# Uma frase sobre o que a empresa vende, pra IA entender as calls. Ex.: consultoria de marketing pra clínicas
IA_SOBRE_A_EMPRESA=
# Palavras que a transcrição deve reconhecer (nomes da empresa, produtos, equipe), separadas por vírgula.
TRANSCRICAO_PALAVRAS=

# IA pelo OpenRouter (resumo da ficha do lead e resumo da call). Sem as duas, essas funções ficam desligadas.
# openrouter.ai → Keys → Create Key.
OPENROUTER_API_KEY=
# Id do modelo no OpenRouter (formato empresa/modelo, copiado de openrouter.ai/models). Vários = separados por
# vírgula: o primeiro é o principal, os outros reserva.
OPENROUTER_TEXT_MODEL=

# Gravações no seu bucket do Cloudflare R2 (sem as três, a gravação fica 7 dias no armazenamento da Cloudflare).
# Cloudflare → R2 → Manage API Tokens → token com "Object Read & Write" só no bucket das gravações.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nome do bucket que você criou no R2. Ex.: vortex-call-gravacoes
R2_BUCKET=

# Token do webhook de vendas (vai no fim da URL /api/webhooks/pay/<token>). Sem ele, a rota fica desligada.
# Gere com: openssl rand -hex 24
PAY_WEBHOOK_TOKEN=

# Só pro comando "npm run rtk:setup": cor dos botões da sala (hex). Padrão: #0a8452
COR_MARCA=
